# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead.
# NEVER commit the real values — .env.local is gitignored on purpose.

# Airtable Personal Access Token (create at https://airtable.com/create/tokens)
# Needs scopes: data.records:read, data.records:write against your base.
AIRTABLE_API_KEY=

# The base ID, found in the Airtable API docs for your base (starts with "app...")
AIRTABLE_BASE_ID=

# Optional: override table names if yours differ from the defaults below.
AIRTABLE_EXERCISES_TABLE=Exercises
AIRTABLE_LOGS_TABLE=Logs
AIRTABLE_PEOPLE_TABLE=People
